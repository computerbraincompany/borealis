{
  "name": "borealis-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13 <23",
    "npm": ">=10.9 <11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/copy-data-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write 'src/**/*.ts' '*.config.ts' 'eslint.config.js' 'package.json'",
    "format:check": "prettier --check 'src/**/*.ts' '*.config.ts' 'eslint.config.js' 'package.json'"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@lancedb/lancedb": "0.37.1",
    "bcryptjs": "^3.0.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.1",
    "marked": "^18.0.11",
    "openai": "^4.77.0",
    "pdfjs-dist": "^4.8.69",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
