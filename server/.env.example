# Optional browser/server overrides. No .env file is required.
# To use one, copy this to server/.env and start the server from server/.
# Shell environment values take precedence; restart after changing them.
# Desktop ignores .env files and sets its own bind/storage/render paths.
# Use its absolute --user-data-dir argument to choose a separate desktop profile.

# --- server ---
# Integer 0-65535; 0 requests an OS-assigned port. Vite's proxy expects 3000.
PORT=3000
# HOST=127.0.0.1  # set 0.0.0.0 only if you deliberately want LAN access
# Comma-separated exact HTTP(S) origins, with no paths or trailing slash.
# An empty value permits no cross-origin browser requests. Used only when the
# server is not serving a built UI; arbitrary origins are never reflected.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Serve a built UI from the API origin (directory must contain index.html).
# Relative paths resolve from the server process's working directory.
# STATIC_WEB_DIR=../web/dist

# When JWT_SECRET is omitted, Borealis creates a random mode-0600 secret once
# at JWT_SECRET_FILE (default: <BOREALIS_DATA_DIR>/jwt.secret). An explicit
# value wins over that file, must contain 32-4096 characters without control
# characters, and must not be a known weak secret. Generate it randomly.
# Leave the following lines commented to use the generated secret; an explicitly
# empty JWT_SECRET is invalid. Preserve any operator-supplied secret in backups.
# JWT_SECRET=
# JWT_SECRET_FILE=

# Embedded storage defaults to <repo>/.borealis in browser development and to
# Electron userData in the desktop app. These path overrides apply to the
# standalone server; desktop main sets exact paths under its selected profile.
# Defaults below BOREALIS_DATA_DIR: borealis.sqlite, lancedb/, uploads/, reports/,
# settings.json, and jwt.secret. Use absolute paths for intentional relocations.
# Stop Borealis before moving/restoring data; SQLite and LanceDB must stay paired.
# BOREALIS_DATA_DIR=
# SQLITE_PATH=
# LANCEDB_DIR=
# UPLOAD_DIR=
# REPORT_DIR=
# SETTINGS_FILE=
# SETTINGS_PATH=  # legacy fallback, used only when SETTINGS_FILE is unset/empty

# Rendering defaults to Playwright in the standalone server; install Chromium.
# RENDER_BACKEND=electron and BOREALIS_DESKTOP=1 are owned by the desktop shell.
# Setting them manually does not create the required Electron IPC renderer.

# --- OpenAI-compatible model endpoint ---
# Configure these in Settings > Models. Provider settings are shared by all
# accounts on the same server. Environment values are CI/operator overrides and
# disable the corresponding Settings field, including an explicitly empty key.
# Use a bare origin without /v1, other paths, credentials, query, or fragment.
# Non-loopback origins require HTTPS. Borealis appends /v1 and uses this one
# origin for model discovery, chat completions, and embeddings.
# LLM_BASE_URL=http://127.0.0.1:1234
# Unset preserves any saved key; an explicitly empty value forces keyless calls.
# Nonempty keys are limited to 8192 characters and cannot contain NUL/CR/LF.
# LLM_API_KEY=
# When the chat endpoint is remote, this optional distinct local runtime may be
# checked independently. This is only a health probe, not an embedding endpoint.
# Unset preserves a saved value; empty disables it. An equivalent loopback
# origin is deduplicated. URLs/keys are never returned by health endpoints.
# LM_STUDIO_BASE_URL=http://localhost:1234
# Chat and embedding model IDs are trimmed, must each be 1-256 characters, and
# must be distinct even after alias resolution. Control characters are rejected.
# The chat model needs streaming tool-call support. Embeddings support ingestion
# and retrieval and are excluded from the chat selector. Alias mappings live in
# src/llmAliases.ts; arbitrary provider model IDs also work.
# LLM_CHAT_MODEL=qwen-chat
# LLM_EMBED_MODEL=nomic-embed
# Existing deployments may continue using LITELLM_BASE_URL, LITELLM_API_KEY,
# LITELLM_CHAT_MODEL, and LITELLM_EMBED_MODEL as lower-precedence compatibility
# aliases. Borealis calls the configured provider directly without an
# intermediary process.
# A remote provider receives ingestion text for embeddings as well as retrieval
# queries, prompts, chat history, and selected source/tool context.

# Positive integer, maximum 16384. Match the embedding model's output dimension.
# A same-dimension model change requires reingesting all sources. LanceDB fixes
# the dimension at creation; a different value prevents an existing table from
# reopening. Use a new complete data directory or a deliberate migration for a
# dimension change. Reingestion alone cannot resize the table.
EMBEDDING_DIM=768

# Resource budgets (defaults shown; all must be positive integers).
# Invalid values abort startup. Further fixed processing/output limits still
# apply; see docs/API.md. Raising upload size does not raise parser/query limits.
# Maximum: 262144000 bytes (250 MiB).
MAX_UPLOAD_BYTES=26214400
# Maximum: 100000 characters.
MAX_MESSAGE_CHARS=32000
# Maximum configured value: 500; caps the agent history read. The default HTTP
# history page is min(value,100), with a separate 100-message page maximum.
MAX_HISTORY_MESSAGES=80
# Maximum: 500000 characters; must be >= MAX_MESSAGE_CHARS + 36000.
MAX_HISTORY_CHARS=120000
# Maximum: 10000000 extracted characters per source.
MAX_EXTRACTED_CHARS=2000000
# Maximum: 10000 chunks per source.
MAX_INGEST_CHUNKS=2500
