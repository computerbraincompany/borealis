# --- server ---
PORT=3000
# HOST=127.0.0.1  # set 0.0.0.0 only if you deliberately want LAN access
# REQUIRED: a random secret of at least 32 chars, e.g. `openssl rand -base64 32`.
# Never run with a default/placeholder value.
JWT_SECRET=
# Default to repo-relative uploads/reports_storage; set these only to override:
# UPLOAD_DIR=
# REPORT_DIR=

# --- postgres ---
DATABASE_URL=postgres://borealis:borealis_password@localhost:5433/borealis

# --- LiteLLM (any OpenAI-compatible endpoint) ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-borealis-local
# Chat and embedding model IDs are trimmed, must each be 1-256 characters, and
# must be distinct. The embedding model is reserved for ingestion and is not
# offered in the per-chat model selector.
LITELLM_CHAT_MODEL=qwen-chat
LITELLM_EMBED_MODEL=nomic-embed
# This dimension belongs to the configured embedding model and existing vector schema.
EMBEDDING_DIM=768

# --- python report service ---
PYTHON_SERVICE_URL=http://localhost:8000
