# --- server ---
PORT=3000
# HOST=127.0.0.1  # set 0.0.0.0 only if you deliberately want LAN access
# Comma-separated exact browser origins. Arbitrary origins are never reflected.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# No .env file is required. When JWT_SECRET is omitted, Borealis creates a
# random 0600 secret once below BOREALIS_DATA_DIR. An explicit value must be
# random and at least 32 characters.
# JWT_SECRET=
# JWT_SECRET_FILE=

# Embedded storage defaults to <repo>/.borealis in browser development and to
# Electron userData in the packaged app. Override only for an intentional move.
# BOREALIS_DATA_DIR=
# SQLITE_PATH=
# LANCEDB_DIR=
# UPLOAD_DIR=
# REPORT_DIR=
# SETTINGS_FILE=

# --- OpenAI-compatible model endpoint ---
# Configure these in the existing Settings modal. Environment values are CI or
# operator overrides and disable the corresponding Settings field.
# LLM_BASE_URL=http://127.0.0.1:1234
# LLM_API_KEY=
# When the chat endpoint is remote, this optional distinct local runtime may be
# checked independently. URLs and keys are never returned by health endpoints.
# LM_STUDIO_BASE_URL=http://localhost:1234
# Chat and embedding model IDs are trimmed, must each be 1-256 characters, and
# must be distinct. The embedding model is reserved for ingestion and is not
# offered in the per-chat model selector.
# LLM_CHAT_MODEL=qwen-chat
# LLM_EMBED_MODEL=nomic-embed
# Existing deployments may continue using LITELLM_BASE_URL, LITELLM_API_KEY,
# LITELLM_CHAT_MODEL, and LITELLM_EMBED_MODEL as lower-precedence compatibility
# aliases. Borealis calls the configured provider directly without an
# intermediary process.
# LanceDB fixes this dimension when its table is first created. Keep it
# compatible with the embedding model and reingest sources after a model change.
EMBEDDING_DIM=768

# Resource budgets (defaults shown)
MAX_UPLOAD_BYTES=26214400
MAX_MESSAGE_CHARS=32000
MAX_HISTORY_MESSAGES=80
MAX_HISTORY_CHARS=120000
MAX_EXTRACTED_CHARS=2000000
MAX_INGEST_CHUNKS=2500
