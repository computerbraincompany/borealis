{
  "name": "borealis",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=borealis-server --filter=borealis-web",
    "dev:desktop": "turbo run dev --filter=borealis-desktop",
    "lint": "turbo run lint",
    "package:unsigned": "turbo run package:unsigned --filter=borealis-desktop",
    "policy": "node scripts/policy-check.mjs",
    "preinstall": "node -e \"if (!/pnpm/.test(process.env.npm_execpath || '')) { console.error('This repository uses pnpm. Run: corepack enable && pnpm install'); process.exit(1); }\"",
    "test": "turbo run test",
    "test:e2e:product": "node scripts/e2e/run-product.mjs --journey=all",
    "test:e2e:product:desktop": "node scripts/e2e/run-product-desktop.mjs --journey=all",
    "test:e2e:product:live": "node scripts/e2e/run-product-live.mjs",
    "test:e2e:product:storage": "pnpm --filter borealis-server exec tsx ../scripts/e2e/run-product-storage.mjs",
    "test:e2e:product:lifecycle": "node scripts/e2e/run-product-lifecycle.mjs",
    "typecheck": "turbo run typecheck",
    "verify": "node scripts/policy-check.mjs && turbo run typecheck lint format:check test test:integration build native:smoke && node -e \"process.stdout.write('ALL GATES GREEN\\n')\"",
    "workspace:archive": "pnpm --filter borealis-server workspace:archive"
  },
  "pnpm": {
    "overrides": {
      "@duckdb/node-api": "1.5.5-r.4",
      "@fastify/static": "10.1.3",
      "@lancedb/lancedb": "0.37.1",
      "@modelcontextprotocol/sdk": "1.30.0",
      "apache-arrow": "18.1.0",
      "better-sqlite3": "13.0.3",
      "docx": "9.7.1",
      "tar-stream": "3.2.1"
    }
  },
  "devDependencies": {
    "turbo": "2.10.12"
  }
}
